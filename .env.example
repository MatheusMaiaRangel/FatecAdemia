# Copie para .env e preencha. O .env não vai para o Git.

DB_URL=jdbc:mysql://localhost:3306/fatecademia?createDatabaseIfNotExist=true
DB_USUARIO=
DB_SENHA=

# Mínimo de 32 caracteres. Gere um com: openssl rand -base64 48
JWT_SEGREDO=
# Formato de duração do Spring: 30m, 2h, 1d
JWT_EXPIRACAO=2h

# Administrador criado automaticamente na primeira subida (senha com 8 a 72 caracteres)
ADMIN_NOME=Administrador
ADMIN_EMAIL=
ADMIN_SENHA=
